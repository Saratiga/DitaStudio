  <title>Счётчик электрической энергии СЕ207 R7 — руководство пользователя</title>

  <!-- Ключи модели: единственное место, которое меняется при переносе руководства
       на другой прибор учёта. Все топики со специфичными числами и обозначениями
       ссылаются на эти ключи через keyref, а не хранят значения в тексте. -->
  <keydef keys="product-model">
    <topicmeta><keywords><keyword>СЕ207 R7</keyword></keywords></topicmeta>
  </keydef>
  <keydef keys="product-model-short">
    <topicmeta><keywords><keyword>СЕ207</keyword></keywords></topicmeta>
  </keydef>
  <keydef keys="product-name">
    <topicmeta><keywords>
      <keyword>Счётчик электрической энергии однофазный многофункциональный СЕ207 R7</keyword>
    </keywords></topicmeta>
  </keydef>
  <keydef keys="fw-version">
    <topicmeta><keywords><keyword>12.X</keyword></keywords></topicmeta>
  </keydef>
  <keydef keys="doc-number">
    <topicmeta><keywords><keyword>САНТ.411152.194-01</keyword></keywords></topicmeta>
  </keydef>
  <keydef keys="voltage-nom">
    <topicmeta><keywords><keyword>230 В</keyword></keywords></topicmeta>
  </keydef>
  <keydef keys="current-base">
    <topicmeta><keywords><keyword>5</keyword></keywords></topicmeta>
  </keydef>
  <keydef keys="current-max">
    <topicmeta><keywords><keyword>80</keyword></keywords></topicmeta>
  </keydef>
  <keydef keys="module-family">
    <topicmeta><keywords><keyword>СЕ812</keyword></keywords></topicmeta>
  </keydef>
  <keydef keys="dimensions-hwd">
    <topicmeta><keywords><keyword>135 × 90 × 62</keyword></keywords></topicmeta>
  </keydef>

