<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Плоские стили редактора поверх темы Fluent — повторяют WPF-версию
         (src/DitaStudio.App/Themes/Controls.xaml): те же отступы, скругления, подчёркивание
         активной вкладки, мягкая подсветка выделения. Все цвета — через DynamicResource
         из Palette.axaml, поэтому светлая и тёмная темы переключаются без перезапуска. -->

    <!-- ============================================================ Окно и контейнеры -->

    <Style Selector="Window">
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Background" Value="{DynamicResource Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>

    <Style Selector="GridSplitter">
        <Setter Property="Background" Value="{DynamicResource Line}" />
        <Setter Property="MinWidth" Value="4" />
        <Setter Property="MinHeight" Value="4" />
    </Style>

    <Style Selector="ToolTip">
        <Setter Property="Background" Value="{DynamicResource SurfaceAlt}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- ============================================================ Меню -->

    <Style Selector="Menu">
        <Setter Property="Background" Value="{DynamicResource SurfaceAlt}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="Padding" Value="4,3" />
        <!-- Fluent задаёт полосе меню фиксированную высоту (MenuBarHeight = 32): с отступами
             как в WPF текст пунктов в неё не помещается и срезается снизу. Высота — по содержимому. -->
        <Setter Property="Height" Value="NaN" />
    </Style>

    <Style Selector="Menu > MenuItem">
        <Setter Property="Padding" Value="10,6" />
    </Style>

    <Style Selector="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="MenuItem /template/ Border#PART_LayoutRoot">
        <Setter Property="CornerRadius" Value="3" />
    </Style>
    <Style Selector="MenuItem:pointerover /template/ Border#PART_LayoutRoot, MenuItem:selected /template/ Border#PART_LayoutRoot, MenuItem:open /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
    </Style>
    <Style Selector="MenuItem:pointerover /template/ ContentPresenter#PART_HeaderPresenter, MenuItem:selected /template/ ContentPresenter#PART_HeaderPresenter">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>
    <Style Selector="MenuItem /template/ TextBlock#PART_InputGestureText">
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
        <Setter Property="FontSize" Value="11.5" />
    </Style>
    <Style Selector="MenuItem:disabled">
        <Setter Property="Foreground" Value="{DynamicResource TextDisabled}" />
    </Style>
    <Style Selector="MenuItem /template/ Popup > Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceAlt}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="3" />
    </Style>
    <Style Selector="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource SurfaceAlt}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="3" />
    </Style>
    <Style Selector="MenuItem Separator, ContextMenu Separator">
        <Setter Property="Background" Value="{DynamicResource Line}" />
        <Setter Property="Margin" Value="6,4" />
        <Setter Property="Height" Value="1" />
    </Style>

    <!-- ============================================================ Панель инструментов -->

    <Style Selector="Border.toolbar">
        <Setter Property="Background" Value="{DynamicResource SurfaceAlt}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
        <Setter Property="BorderThickness" Value="0,1,0,1" />
        <Setter Property="Padding" Value="6,4" />
    </Style>
    <Style Selector="Border.toolbar Rectangle.separator">
        <Setter Property="Width" Value="1" />
        <Setter Property="Margin" Value="6,4" />
        <Setter Property="Fill" Value="{DynamicResource Line}" />
    </Style>

    <!-- ============================================================ Кнопки -->

    <!-- В своих шаблонах части названы не PART_…: иначе к ним цеплялись бы стили встроенной
         темы Fluent (например, серый фон содержимого у неактивной кнопки). -->

    <Style Selector="Button">
        <Setter Property="Background" Value="{DynamicResource Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                    <ContentPresenter Name="Presenter"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Foreground="{TemplateBinding Foreground}"
                                      Margin="{TemplateBinding Padding}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button:pointerover /template/ Border#Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LineStrong}" />
    </Style>
    <Style Selector="Button:pressed /template/ Border#Border">
        <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
    </Style>
    <Style Selector="Button:disabled">
        <Setter Property="Foreground" Value="{DynamicResource TextDisabled}" />
    </Style>
    <Style Selector="Button:disabled /template/ Border#Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceAlt}" />
    </Style>

    <!-- Плоские кнопки-иконки на главной панели инструментов. -->
    <Style Selector="Button.tool">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="7,5" />
        <Setter Property="Margin" Value="1,0" />
        <Setter Property="MinWidth" Value="30" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <!-- Кнопка закрытия вкладки документа. -->
    <Style Selector="Button.tabclose">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="Margin" Value="8,0,0,0" />
        <Setter Property="FontSize" Value="10" />
    </Style>

    <!-- ============================================================ Вкладки -->

    <Style Selector="TabControl">
        <Setter Property="Background" Value="{DynamicResource Surface}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <DockPanel>
                    <Border DockPanel.Dock="Top"
                            Background="{DynamicResource SurfaceAlt}"
                            BorderBrush="{DynamicResource Line}"
                            BorderThickness="0,0,0,1">
                        <ItemsPresenter Name="PART_ItemsPresenter"
                                        ItemsPanel="{TemplateBinding ItemsPanel}"
                                        Margin="4,0,4,-1" />
                    </Border>
                    <ContentPresenter Name="PART_SelectedContentHost"
                                      Background="{TemplateBinding Background}"
                                      Content="{TemplateBinding SelectedContent}"
                                      ContentTemplate="{TemplateBinding SelectedContentTemplate}" />
                </DockPanel>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="TabItem">
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Padding" Value="12,7,12,6" />
        <Setter Property="Margin" Value="0,0,2,0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="Transparent"
                        BorderThickness="0,0,0,2"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter Name="Presenter"
                                      Content="{TemplateBinding Header}"
                                      ContentTemplate="{TemplateBinding HeaderTemplate}"
                                      Foreground="{TemplateBinding Foreground}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="TabItem:pointerover /template/ Border#Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
    </Style>
    <Style Selector="TabItem:selected">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TabItem:selected /template/ Border#Border">
        <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    </Style>

    <!-- ============================================================ Дерево -->

    <Style Selector="TreeView">
        <Setter Property="Background" Value="{DynamicResource Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="4" />
    </Style>
    <Style Selector="TreeViewItem">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="TreeViewItem /template/ Border#PART_LayoutRoot">
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="MinHeight" Value="24" />
    </Style>
    <Style Selector="TreeViewItem /template/ Border#PART_LayoutRoot:pointerover">
        <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
    </Style>
    <Style Selector="TreeViewItem:selected /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
    </Style>
    <Style Selector="TreeViewItem:selected /template/ Border#PART_LayoutRoot:pointerover">
        <Setter Property="Background" Value="{DynamicResource AccentHover}" />
    </Style>
    <Style Selector="TreeViewItem:selected /template/ Border#PART_LayoutRoot > ContentPresenter#PART_HeaderPresenter">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>

    <!-- ============================================================ Списки -->

    <Style Selector="ListBox">
        <Setter Property="Background" Value="{DynamicResource Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="2" />
    </Style>
    <Style Selector="ListBoxItem">
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>
    <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentHover}" />
    </Style>

    <!-- Таблицы (в WPF — ListView + GridView): проверка, поиск, ключи. -->
    <Style Selector="DataGrid">
        <Setter Property="Background" Value="{DynamicResource Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="GridLinesVisibility" Value="None" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="CanUserReorderColumns" Value="False" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="RowBackground" Value="Transparent" />
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource SurfaceAlt}" />
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="SeparatorBrush" Value="{DynamicResource Line}" />
    </Style>
    <Style Selector="DataGridRow">
        <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="DataGridCell">
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="DataGridRow:pointerover /template/ Rectangle#BackgroundRectangle">
        <Setter Property="Fill" Value="{DynamicResource SurfaceHover}" />
        <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
        <Setter Property="Fill" Value="{DynamicResource AccentSoft}" />
        <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="DataGridRow:selected">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>
    <Style Selector="DataGridCell:focus /template/ Grid#FocusVisual">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <!-- ============================================================ Поля ввода -->

    <Style Selector="TextBox">
        <Setter Property="Background" Value="{DynamicResource SurfaceSunken}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentHover}" />
        <Setter Property="SelectionForegroundBrush" Value="{DynamicResource TextPrimary}" />
    </Style>
    <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource SurfaceSunken}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LineStrong}" />
    </Style>
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource SurfaceSunken}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="TextBox:pointerover, TextBox:focus">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>
    <!-- Журнал сборки: только чтение, без рамки, моноширинный. -->
    <Style Selector="TextBox.log">
        <Setter Property="Background" Value="{DynamicResource Surface}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
    <Style Selector="TextBox.log:focus /template/ Border#PART_BorderElement, TextBox.log:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource Surface}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="MinHeight" Value="0" />
    </Style>

    <Style Selector="ComboBox">
        <Setter Property="Background" Value="{DynamicResource SurfaceSunken}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="ComboBox:pointerover /template/ Border#Background">
        <Setter Property="Background" Value="{DynamicResource SurfaceSunken}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LineStrong}" />
    </Style>
    <Style Selector="ComboBoxItem">
        <Setter Property="Padding" Value="6,5" />
    </Style>

    <!-- ============================================================ Прокрутка -->

    <Style Selector="ScrollBar /template/ Thumb">
        <Setter Property="Background" Value="{DynamicResource ScrollThumb}" />
    </Style>
    <Style Selector="ScrollBar /template/ Thumb:pointerover">
        <Setter Property="Background" Value="{DynamicResource ScrollThumbHover}" />
    </Style>

    <!-- ============================================================ Строка состояния -->

    <Style Selector="Border.statusbar">
        <Setter Property="Background" Value="{DynamicResource SurfaceAlt}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="8,4" />
    </Style>
    <Style Selector="Border.statusbar TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- Подсказки мелким приглушённым текстом (ключи с областями, палитра вставки). -->
    <Style Selector="TextBlock.hint">
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

</Styles>
