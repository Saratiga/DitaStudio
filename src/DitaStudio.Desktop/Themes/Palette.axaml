<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Палитра редактора — те же цвета, что в WPF-версии (src/DitaStudio.App/Themes/Light.xaml
         и Dark.xaml). Тема переключается через Application.RequestedThemeVariant, стили
         (Controls.axaml) берут цвета через DynamicResource. -->

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <Color x:Key="AccentColor">#1F5FA9</Color>
            <SolidColorBrush x:Key="Accent" Color="#1F5FA9" />
            <SolidColorBrush x:Key="AccentSoft" Color="#E7EFF9" />
            <SolidColorBrush x:Key="AccentHover" Color="#D7E5F5" />
            <SolidColorBrush x:Key="Surface" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SurfaceAlt" Color="#F7F8FA" />
            <SolidColorBrush x:Key="SurfaceSunken" Color="#F1F3F6" />
            <SolidColorBrush x:Key="SurfaceHover" Color="#EEF1F4" />
            <SolidColorBrush x:Key="Line" Color="#DFE3E8" />
            <SolidColorBrush x:Key="LineStrong" Color="#C7CDD6" />
            <SolidColorBrush x:Key="TextPrimary" Color="#1A1C1F" />
            <SolidColorBrush x:Key="TextMuted" Color="#5B6472" />
            <SolidColorBrush x:Key="TextDisabled" Color="#AEB4BD" />
            <SolidColorBrush x:Key="Danger" Color="#C0392B" />
            <SolidColorBrush x:Key="Warning" Color="#C58217" />
            <SolidColorBrush x:Key="Success" Color="#2E7D32" />
            <SolidColorBrush x:Key="TagBrush" Color="#8A94A6" />
            <SolidColorBrush x:Key="AttributeNameBrush" Color="#7A3E9D" />
            <SolidColorBrush x:Key="CodeBackground" Color="#F5F6F8" />
            <SolidColorBrush x:Key="EditorTag" Color="#9AA4B2" />
            <SolidColorBrush x:Key="EditorNoteBackground" Color="#EEF4FB" />
            <SolidColorBrush x:Key="EditorWarnBackground" Color="#FDF3E2" />
            <SolidColorBrush x:Key="EditorChipBackground" Color="#EAEFF7" />
            <SolidColorBrush x:Key="EditorChipBorder" Color="#B9C6DC" />
            <SolidColorBrush x:Key="EditorChipText" Color="#2C4A73" />
            <SolidColorBrush x:Key="ScrollThumb" Color="#C7CDD6" />
            <SolidColorBrush x:Key="ScrollThumbHover" Color="#9AA4B2" />
            <!-- Акцент встроенной темы Fluent — для контролов, которые не переоформлены в Controls.axaml. -->
            <Color x:Key="SystemAccentColor">#1F5FA9</Color>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <Color x:Key="AccentColor">#4C8DDA</Color>
            <SolidColorBrush x:Key="Accent" Color="#4C8DDA" />
            <SolidColorBrush x:Key="AccentSoft" Color="#1B3A5C" />
            <SolidColorBrush x:Key="AccentHover" Color="#234870" />
            <SolidColorBrush x:Key="Surface" Color="#1E1F22" />
            <SolidColorBrush x:Key="SurfaceAlt" Color="#26282C" />
            <SolidColorBrush x:Key="SurfaceSunken" Color="#17181A" />
            <SolidColorBrush x:Key="SurfaceHover" Color="#32343A" />
            <SolidColorBrush x:Key="Line" Color="#3A3D42" />
            <SolidColorBrush x:Key="LineStrong" Color="#4B4F57" />
            <SolidColorBrush x:Key="TextPrimary" Color="#E6E8EB" />
            <SolidColorBrush x:Key="TextMuted" Color="#9AA0AA" />
            <SolidColorBrush x:Key="TextDisabled" Color="#5B5F66" />
            <SolidColorBrush x:Key="Danger" Color="#E5534B" />
            <SolidColorBrush x:Key="Warning" Color="#E0A040" />
            <SolidColorBrush x:Key="Success" Color="#4CAF6D" />
            <SolidColorBrush x:Key="TagBrush" Color="#7D8590" />
            <SolidColorBrush x:Key="AttributeNameBrush" Color="#C792EA" />
            <SolidColorBrush x:Key="CodeBackground" Color="#2A2C30" />
            <SolidColorBrush x:Key="EditorTag" Color="#7D8A9E" />
            <SolidColorBrush x:Key="EditorNoteBackground" Color="#1E2A38" />
            <SolidColorBrush x:Key="EditorWarnBackground" Color="#3A2E14" />
            <SolidColorBrush x:Key="EditorChipBackground" Color="#253247" />
            <SolidColorBrush x:Key="EditorChipBorder" Color="#3D5573" />
            <SolidColorBrush x:Key="EditorChipText" Color="#9DC0EC" />
            <SolidColorBrush x:Key="ScrollThumb" Color="#4B4F57" />
            <SolidColorBrush x:Key="ScrollThumbHover" Color="#6B7078" />
            <!-- Акцент встроенной темы Fluent — для контролов, которые не переоформлены в Controls.axaml. -->
            <Color x:Key="SystemAccentColor">#4C8DDA</Color>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <x:Double x:Key="EditorFontSize">14.5</x:Double>
    <!-- Segoe UI и Cascadia/Consolas — на Windows, как в WPF-версии; на Linux/macOS — Inter
         (встроен в приложение) и системный моноширинный. -->
    <FontFamily x:Key="UiFont">Segoe UI, fonts:Inter#Inter, $Default</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, DejaVu Sans Mono, Menlo, monospace</FontFamily>

</ResourceDictionary>
