<Window x:Class="DitaStudio.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DitaStudio.App.ViewModels"
        Title="{Binding WindowTitle}" Height="820" Width="1440"
        Icon="app.ico"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <DockPanel>

        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Файл">
                <MenuItem Header="Открыть папку проекта…" Command="{Binding ProjectPanel.OpenProjectCommand}" InputGestureText="Ctrl+Shift+O" />
                <MenuItem Header="Недавние проекты" x:Name="RecentProjectsMenu" />
                <MenuItem Header="Создать документ…" Click="OnNewDocument" InputGestureText="Ctrl+N" />
                <Separator />
                <MenuItem Header="Сохранить" Command="{Binding Documents.SaveCurrentCommand}" InputGestureText="Ctrl+S" />
                <MenuItem Header="Сохранить всё" Command="{Binding Documents.SaveAllCommand}" InputGestureText="Ctrl+Shift+S" />
                <MenuItem Header="Закрыть вкладку" Command="{Binding Documents.CloseCurrentTabCommand}" InputGestureText="Ctrl+W" />
                <Separator />
                <MenuItem Header="Выход" Click="OnExit" />
            </MenuItem>

            <MenuItem Header="_Правка">
                <MenuItem Header="Отменить структурное изменение" Command="{Binding Insert.UndoCommand}" InputGestureText="Ctrl+Alt+Z" />
                <MenuItem Header="Повторить" Command="{Binding Insert.RedoCommand}" InputGestureText="Ctrl+Alt+Y" />
                <Separator />
                <MenuItem Header="Найти в проекте…" Click="OnFocusSearch" InputGestureText="Ctrl+Shift+F" />
                <MenuItem Header="Проверить проект" Command="{Binding Validation.ValidateProjectCommand}" InputGestureText="F7" />
                <MenuItem Header="Проверить документ" Command="{Binding Validation.ValidateDocumentCommand}" />
                <Separator />
                <MenuItem Header="Сравнить файлы…" Command="{Binding Validation.CompareFilesCommand}" />
                <MenuItem Header="Сравнить с последним коммитом (git)" Command="{Binding Validation.CompareWithGitHeadCommand}" />
            </MenuItem>

            <MenuItem Header="_Вставка">
                <MenuItem Header="Элемент…" Click="OnFocusPalette" InputGestureText="Ctrl+E" />
                <Separator />
                <MenuItem Header="Абзац" Command="{Binding Insert.InsertParagraphCommand}" />
                <MenuItem Header="Маркированный список" Command="{Binding Insert.InsertUlCommand}" />
                <MenuItem Header="Нумерованный список" Command="{Binding Insert.InsertOlCommand}" />
                <MenuItem Header="Примечание" Command="{Binding Insert.InsertNoteCommand}" />
                <MenuItem Header="Блок кода" Command="{Binding Insert.InsertCodeblockCommand}" />
                <MenuItem Header="Сноска" Command="{Binding Insert.InsertFootnoteCommand}" />
                <MenuItem Header="Таблица…" Command="{Binding Insert.InsertTableCommand}" />
                <MenuItem Header="Изображение…" Command="{Binding Insert.InsertImageCommand}" />
                <MenuItem Header="Перекрёстная ссылка…" Command="{Binding Insert.InsertXrefCommand}" />
                <Separator />
                <MenuItem Header="Полужирный" Command="{Binding Insert.FormatBoldCommand}" InputGestureText="Ctrl+B" />
                <MenuItem Header="Курсив" Command="{Binding Insert.FormatItalicCommand}" InputGestureText="Ctrl+I" />
                <MenuItem Header="Код в строке" Command="{Binding Insert.FormatCodeCommand}" />
                <MenuItem Header="Элемент интерфейса" Command="{Binding Insert.FormatUicontrolCommand}" />
            </MenuItem>

            <MenuItem Header="_Структура">
                <MenuItem Header="Переместить вверх" Command="{Binding Insert.MoveUpCommand}" InputGestureText="Ctrl+Shift+Up" />
                <MenuItem Header="Переместить вниз" Command="{Binding Insert.MoveDownCommand}" InputGestureText="Ctrl+Shift+Down" />
                <MenuItem Header="Удалить элемент" Command="{Binding Insert.DeleteElementCommand}" />
                <MenuItem Header="Переименовать id…" Command="{Binding Insert.RenameIdCommand}"
                          ToolTip="Обновляет ссылки (href, conref) на этот id по всему проекту" />
                <MenuItem Header="Вынести в conref…" Command="{Binding Insert.ExtractToConrefCommand}"
                          ToolTip="Переносит элемент в другой топик, оставляя на месте ссылку conref" />
                <Separator />
                <MenuItem Header="Объединить ячейку со следующей" Command="{Binding Insert.MergeCellRightCommand}" InputGestureText="Ctrl+Alt+Right" />
                <MenuItem Header="Объединить ячейку со строкой ниже" Command="{Binding Insert.MergeCellDownCommand}" InputGestureText="Ctrl+Alt+Down" />
                <Separator />
                <MenuItem Header="Разрыв страницы перед заголовком (печать)" Command="{Binding Insert.TogglePageBreakBeforeTitleCommand}" />
                <MenuItem Header="Таблица: разрешить перенос с повтором шапки (печать)" Command="{Binding Insert.ToggleTablePageBreakAutoCommand}" />
                <MenuItem Header="Отметить как изменённое (rev)" Command="{Binding Insert.ToggleRevChangedCommand}"
                          ToolTip="Полоса на полях при публикации — штатная DITA-пометка ревизии, не полноценная история правок" />
                <Separator />
                <MenuItem Header="Показывать имена элементов" IsCheckable="True" IsChecked="{Binding Insert.ShowElementTags, Mode=TwoWay}" />
            </MenuItem>

            <MenuItem Header="_Публикация">
                <MenuItem Header="Собрать сайт HTML…" Command="{Binding Publish.PublishSiteCommand}" InputGestureText="F5" />
                <MenuItem Header="Собрать один HTML…" Command="{Binding Publish.PublishSingleCommand}" />
                <MenuItem Header="Экспорт в PDF…" Command="{Binding Publish.PublishPdfCommand}" />
                <MenuItem Header="Экспорт в DOCX…" Command="{Binding Publish.ExportDocxCommand}" />
                <Separator />
                <MenuItem Header="Условия сборки…" Command="{Binding Publish.PublishConditionsCommand}" />
                <MenuItem Header="Подключить .ditaval…" Command="{Binding Publish.ImportDitavalCommand}" />
                <MenuItem Header="Пользовательский CSS…" Command="{Binding Publish.CustomCssCommand}" />
                <MenuItem Header="Колонтитулы PDF…" Command="{Binding Publish.PdfHeaderFooterCommand}" />
            </MenuItem>

            <MenuItem Header="_Справка">
                <MenuItem Header="Об элементе под курсором" Command="{Binding Help.ShowElementHelpCommand}" InputGestureText="F1" />
                <MenuItem x:Name="ThemeMenuItem" Header="Тёмная тема" IsCheckable="True" Click="OnToggleTheme" />
                <Separator />
                <MenuItem Header="О программе" Command="{Binding Help.AboutCommand}" />
            </MenuItem>
        </Menu>

        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Button Style="{StaticResource ToolButton}" Content="📂" Command="{Binding ProjectPanel.OpenProjectCommand}" ToolTip="Открыть папку проекта (Ctrl+Shift+O)" />
                <Button Style="{StaticResource ToolButton}" Content="➕" Click="OnNewDocument" ToolTip="Создать документ (Ctrl+N)" />
                <Button Style="{StaticResource ToolButton}" Content="💾" Command="{Binding Documents.SaveCurrentCommand}" ToolTip="Сохранить (Ctrl+S)" />
                <Separator />
                <Button Style="{StaticResource ToolButton}" Content="↩" Command="{Binding Insert.UndoCommand}" ToolTip="Отменить структурное изменение (Ctrl+Alt+Z)" />
                <Button Style="{StaticResource ToolButton}" Content="↪" Command="{Binding Insert.RedoCommand}" ToolTip="Повторить (Ctrl+Alt+Y)" />
                <Separator />
                <Button Style="{StaticResource ToolButton}" Content="Ж" FontWeight="Bold" Command="{Binding Insert.FormatBoldCommand}" ToolTip="Полужирный (Ctrl+B)" />
                <Button Style="{StaticResource ToolButton}" Content="К" FontStyle="Italic" Command="{Binding Insert.FormatItalicCommand}" ToolTip="Курсив (Ctrl+I)" />
                <Button Style="{StaticResource ToolButton}" Content="&lt;/&gt;" FontFamily="Consolas" FontSize="12" Command="{Binding Insert.FormatCodeCommand}" ToolTip="Код в строке" />
                <Separator />
                <Button Style="{StaticResource ToolButton}" Content="↑" Command="{Binding Insert.MoveUpCommand}" ToolTip="Переместить элемент вверх (Ctrl+Shift+Up)" />
                <Button Style="{StaticResource ToolButton}" Content="↓" Command="{Binding Insert.MoveDownCommand}" ToolTip="Переместить элемент вниз (Ctrl+Shift+Down)" />
                <Button Style="{StaticResource ToolButton}" Content="🗑" Command="{Binding Insert.DeleteElementCommand}" ToolTip="Удалить элемент" />
                <Separator />
                <Button Style="{StaticResource ToolButton}" Content="⇔" Command="{Binding Insert.MergeCellRightCommand}" ToolTip="Объединить ячейку таблицы со следующей (Ctrl+Alt+→)" />
                <Button Style="{StaticResource ToolButton}" Content="⇕" Command="{Binding Insert.MergeCellDownCommand}" ToolTip="Объединить ячейку таблицы со строкой ниже (Ctrl+Alt+↓)" />
                <Separator />
                <Button Style="{StaticResource ToolButton}" Content="✔" Command="{Binding Validation.ValidateProjectCommand}" ToolTip="Проверить проект (F7)" />
                <Button Style="{StaticResource ToolButton}" Content="▶" Command="{Binding Publish.PublishSiteCommand}" ToolTip="Собрать сайт HTML (F5)" />
            </ToolBar>
        </ToolBarTray>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="{Binding ContextText}" Foreground="{DynamicResource TextMuted}" />
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="200" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" MinWidth="420" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="320" MinWidth="220" />
            </Grid.ColumnDefinitions>

            <TabControl Grid.Column="0" x:Name="LeftTabs">
                <TabItem Header="Проект">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4">
                            <Button Content="Обновить" Padding="8,3" Command="{Binding ProjectPanel.RescanProjectCommand}" />
                            <Button Content="Создать…" Padding="8,3" Margin="4,0,0,0" Click="OnNewDocument" />
                        </StackPanel>
                        <TreeView x:Name="ProjectTree" BorderThickness="0"
                                  MouseDoubleClick="OnProjectTreeDoubleClick"
                                  PreviewMouseRightButtonDown="OnProjectTreeRightClick">
                            <TreeView.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Переименовать / переместить файл…" Click="OnProjectFileMove" />
                                </ContextMenu>
                            </TreeView.ContextMenu>
                        </TreeView>
                    </DockPanel>
                </TabItem>

                <TabItem Header="Карта">
                    <DockPanel>
                        <ComboBox x:Name="MapSelector" DockPanel.Dock="Top" Margin="4"
                                  ItemsSource="{Binding Map.Maps}" SelectedItem="{Binding Map.SelectedMap}"
                                  DisplayMemberPath="RelativePath" />
                        <WrapPanel DockPanel.Dock="Top" Margin="4,0,4,4">
                            <Button Content="+ Топик" Padding="6,3" Margin="0,0,3,3" Click="OnMapAddTopicref" ToolTip="Добавить ссылку на топик" />
                            <Button Content="+ Раздел" Padding="6,3" Margin="0,0,3,3" Click="OnMapAddTopichead" />
                            <Button Content="↑" Padding="6,3" Margin="0,0,3,3" Click="OnMapMoveUp" />
                            <Button Content="↓" Padding="6,3" Margin="0,0,3,3" Click="OnMapMoveDown" />
                            <Button Content="→" Padding="6,3" Margin="0,0,3,3" Click="OnMapIndent" ToolTip="Сделать вложенным" />
                            <Button Content="←" Padding="6,3" Margin="0,0,3,3" Click="OnMapOutdent" />
                            <Button Content="✕" Padding="6,3" Margin="0,0,3,3" Click="OnMapDelete" />
                            <Button Content="Таблица соответствий…" Padding="6,3" Margin="0,0,3,3" Click="OnEditRelTable" />
                        </WrapPanel>
                        <TreeView x:Name="MapTreeView" BorderThickness="0" AllowDrop="True"
                                  MouseDoubleClick="OnMapTreeDoubleClick"
                                  SelectedItemChanged="OnMapTreeSelectionChanged"
                                  PreviewMouseLeftButtonDown="OnMapTreeMouseDown"
                                  PreviewMouseMove="OnMapTreeMouseMove"
                                  DragOver="OnMapTreeDragOver"
                                  Drop="OnMapTreeDrop" />
                    </DockPanel>
                </TabItem>

                <TabItem Header="Ключи">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Bottom" Margin="8,4,8,8"
                                   FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}"
                                   Text="{Binding ProjectPanel.ScopedKeysHintText}"
                                   Visibility="{Binding ProjectPanel.ScopedKeysHintVisible, Converter={StaticResource BoolToVis}}" />
                        <ListView ItemsSource="{Binding ProjectPanel.Keys}" SelectedItem="{Binding ProjectPanel.SelectedKey}" BorderThickness="0" MouseDoubleClick="OnKeyDoubleClick">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Ключ" Width="110" DisplayMemberBinding="{Binding Key}" />
                                    <GridViewColumn Header="Цель" Width="160" DisplayMemberBinding="{Binding Href}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </DockPanel>
                </TabItem>
            </TabControl>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" />

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="200" />
                    <RowDefinition Height="4" />
                    <RowDefinition Height="200" MinHeight="80" />
                </Grid.RowDefinitions>

                <TabControl Grid.Row="0" x:Name="DocumentTabs"
                            ItemsSource="{Binding Documents.Tabs}"
                            SelectedItem="{Binding Documents.SelectedTab}">
                    <TabControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:TabViewModel}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                                <Button Content="✕" FontSize="10" Padding="4,0,4,0" Margin="8,0,0,0"
                                        BorderThickness="0" Background="Transparent"
                                        Command="{Binding CloseCommand}" />
                            </StackPanel>
                        </DataTemplate>
                    </TabControl.ItemTemplate>
                    <TabControl.ContentTemplate>
                        <DataTemplate DataType="{x:Type vm:TabViewModel}">
                            <ContentControl Content="{Binding Pane}" />
                        </DataTemplate>
                    </TabControl.ContentTemplate>
                </TabControl>

                <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" />

                <TabControl Grid.Row="2" x:Name="BottomTabs" SelectedIndex="{Binding BottomTabIndex}">
                    <TabItem Header="Проверка">
                        <ListView ItemsSource="{Binding Validation.Issues}" SelectedItem="{Binding Validation.SelectedIssue}" BorderThickness="0" MouseDoubleClick="OnIssueDoubleClick">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Уровень" Width="110" DisplayMemberBinding="{Binding SeverityText}" />
                                    <GridViewColumn Header="Сообщение" Width="620" DisplayMemberBinding="{Binding Message}" />
                                    <GridViewColumn Header="Место" Width="220" DisplayMemberBinding="{Binding Location}" />
                                    <GridViewColumn Header="Файл" Width="260" DisplayMemberBinding="{Binding FilePath}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </TabItem>

                    <TabItem Header="Поиск">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBox x:Name="SearchBox" Width="320" Padding="4,3" Text="{Binding Search.SearchText, UpdateSourceTrigger=PropertyChanged}">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Return" Command="{Binding Search.RunCommand}" />
                                        </TextBox.InputBindings>
                                    </TextBox>
                                    <Button Content="Найти" Padding="10,3" Margin="4,0,0,0" Command="{Binding Search.RunCommand}" />
                                    <CheckBox Content="искать имена элементов" Margin="10,0,0,0" VerticalAlignment="Center" IsChecked="{Binding Search.SearchElements}" />
                                    <CheckBox Content="регулярное выражение" Margin="10,0,0,0" VerticalAlignment="Center" IsChecked="{Binding Search.SearchRegex}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBox Width="320" Padding="4,3" ToolTip="Текст замены (для обычного текстового поиска)" Text="{Binding Search.ReplaceText, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button Content="Заменить всё" Padding="10,3" Margin="4,0,0,0" Command="{Binding Search.ReplaceAllCommand}" />
                                </StackPanel>
                            </StackPanel>
                            <ListView ItemsSource="{Binding Search.Results}" SelectedItem="{Binding Search.SelectedResult}" BorderThickness="0" MouseDoubleClick="OnSearchResultDoubleClick">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Файл" Width="260" DisplayMemberBinding="{Binding File.RelativePath}" />
                                        <GridViewColumn Header="Фрагмент" Width="700" DisplayMemberBinding="{Binding Context}" />
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </DockPanel>
                    </TabItem>

                    <TabItem Header="Журнал сборки">
                        <TextBox IsReadOnly="True" BorderThickness="0"
                                 FontFamily="Consolas" FontSize="12"
                                 VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                                 HorizontalScrollBarVisibility="Auto"
                                 Text="{Binding Publish.BuildLogText, Mode=OneWay}" />
                    </TabItem>
                </TabControl>
            </Grid>

            <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Stretch" />

            <TabControl Grid.Column="4" x:Name="RightTabs">
                <TabItem Header="Атрибуты">
                    <DockPanel>
                        <TextBlock x:Name="AttributeContext" DockPanel.Dock="Top"
                                   Margin="8,6,8,4" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource TextMuted}" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="AttributePanel" Margin="8,0,8,12" />
                        </ScrollViewer>
                    </DockPanel>
                </TabItem>

                <TabItem Header="Вставка">
                    <DockPanel>
                        <TextBox x:Name="PaletteFilter" DockPanel.Dock="Top" Margin="6" Padding="4,3"
                                 TextChanged="OnPaletteFilterChanged" />
                        <TextBlock x:Name="PaletteHint" DockPanel.Dock="Top" Margin="8,0,8,6"
                                   FontSize="11" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" />
                        <ListBox x:Name="PaletteList" BorderThickness="0" MouseDoubleClick="OnPaletteInsert" />
                    </DockPanel>
                </TabItem>

                <TabItem Header="Структура">
                    <TreeView x:Name="OutlineTree" BorderThickness="0"
                              SelectedItemChanged="OnOutlineSelected" />
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
